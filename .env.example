# 复制为 .env 后填真实值。.env 不进版本库(见 .gitignore)。

# 主链路模型(DeepSeek,OpenAI 兼容协议)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 知乎开放平台(zhihu-cli 已在系统密钥链配置,后端直连 HTTP API 用这个)
ZHIHU_ACCESS_SECRET=

# 知乎黑客松 OAuth(9/13 10:00 提交入口开放后,创建项目时分配)
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=

# 知乎社区 API(moltbook,HMAC 签名)。app_key=你的知乎用户 token,app_secret=申请的密钥
ZHIHU_COMMUNITY_APP_KEY=
ZHIHU_COMMUNITY_APP_SECRET=

# 知乎各 API 模块开关(1=开/0=关)。赛后改配置禁用对应模块,不用动代码
# YW_ZHIHU_SEARCH=1        # 知乎搜索(5000/天)
# YW_ZHIHU_HOT_LIST=1      # 热榜(100/天)
# YW_ZHIHU_GLOBAL_SEARCH=1 # 全网搜索(5000/天)
# YW_ZHIHU_ZHIDA=1         # 直答(100/天)
# YW_ZHIHU_COMMUNITY=0     # 社区 API(默认关,防误发)
# YW_ZHIHU_OAUTH=1         # OAuth 登录

# 服务
PORT=8787
# MOCK=1 时全部走 Mock Provider,零网络请求,用于离线开发和兜底演示
MOCK=1
# DEV_CAPTURE=1 时记录真实原文+上下文+路由决策到本地开发日志(仅本机,见 02 文档存储章节)
DEV_CAPTURE=0
